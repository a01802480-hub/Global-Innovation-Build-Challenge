# ── BioStream frontend configuration ──────────────────────────────────────
# Copy this file to `.env.local`. ONLY the backend URL may be public here.
#
# NEVER prefix a secret with NEXT_PUBLIC_ — anything NEXT_PUBLIC_* is inlined
# into the JavaScript bundle shipped to the browser. UniProt/Ensembl/AlphaFold
# keys and all LLM/Pinecone credentials belong in backend/.env, nowhere else.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
