# ── BioStream backend configuration ────────────────────────────────────────
# Copy this file to `.env` and edit. EVERY value in this file is SERVER-ONLY:
# nothing here is ever shipped to the browser. Never prefix these with
# NEXT_PUBLIC_* — that is the frontend's namespace and gets baked into the JS
# bundle (see the Security Audit in README.md).

# ── Public data services (no key required — public endpoints) ──────────────
UNIPROT_BASE_URL=https://rest.uniprot.org
ENSEMBL_BASE_URL=https://rest.ensembl.org
INTERPRO_BASE_URL=https://www.ebi.ac.uk/interpro/api
ALPHAMISSENSE_BASE_URL=https://alphamissense.hegelab.org
ALPHAFOLD_BASE_URL=https://alphafold.ebi.ac.uk/api

# ── Optional credentials (server-side only; leave empty when unused) ───────
# Ensembl REST is keyless; set this only for a privileged mirror.
ENSEMBL_API_KEY=

# ── Agentic features (planned; keys stay on the backend, never the client) ─
ANTHROPIC_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# ── Application behaviour ──────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (must match the frontend).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Ortholog species to try, in order (blue whale → minke whale → sperm whale).
ORTHOLOG_SPECIES=balaenoptera_musculus,balaenoptera_acutorostrata,physeter_catodon
RATE_LIMIT_PER_MINUTE=120
REQUEST_TIMEOUT_S=25
# The legacy Ensembl REST hosts currently answer healthy requests in 60-200 s;
# ortholog/ENSP/VEP calls use this longer window (successes cache 24 h).
ENSEMBL_TIMEOUT_S=120
VARIANT_TIMEOUT_S=180
# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
